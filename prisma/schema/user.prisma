model User {
  id          String      @id @default(uuid())
  name        String
  email       String      @unique
  password    String
  phone       String?
  image       String?

  role        Role        @default(CUSTOMER)
  status      UserStatus  @default(UNBAN)

  address     String?
  city        String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  technicianProfile TechnicianProfile?

  customerBookings Booking[] @relation("CustomerBookings")

  technicianBookings Booking[] @relation("TechnicianBookings")

  services Service[]

  reviewGiven Review[] @relation("CustomerReview")

  reviewReceived Review[] @relation("TechnicianReview")
   @@index([role])
  @@index([status])
  @@index([city])
  @@index([createdAt])

  @@map("users")
    
}
